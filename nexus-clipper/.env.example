# NexuX canonical runtime
DEBUG=false
HOST=127.0.0.1
PORT=8000

# Browser origins allowed to call the canonical API.
# Comma-separated; keep production origins explicit.
NEXUX_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Local transcription defaults
WHISPER_MODEL=small

# Optional AI editorial provider. Leave disabled for fully local operation.
NEXUX_AI_ENABLED=0
NEXUX_AI_ENDPOINT=
NEXUX_AI_API_KEY=
NEXUX_AI_MODEL=

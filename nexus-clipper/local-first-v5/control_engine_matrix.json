{
  "version": "1.0.0",
  "source_of_truth": "Fronted production UI + GenerateRequest",
  "controls": {
    "youtube_url": {"engine": "download_youtube", "rendered": true},
    "target_duration": {"engine": "build_candidates/rerank_candidates", "rendered": true},
    "aspect_ratio": {"engine": "spec_for_aspect_ratio", "rendered": true},
    "subtitle_style": {"engine": "PRESETS + render_ass_safe", "rendered": true},
    "font": {"engine": "render_ass_safe", "rendered": true},
    "font_size": {"engine": "render_ass_safe", "rendered": true},
    "primary_color": {"engine": "_style_overrides/_hex_to_ass", "rendered": true},
    "highlight_color": {"engine": "_style_overrides/_hex_to_ass", "rendered": true},
    "stroke_color": {"engine": "_style_overrides/_hex_to_ass", "rendered": true},
    "stroke_width": {"engine": "_style_overrides", "rendered": true},
    "position": {"engine": "_style_overrides/render_ass_safe", "rendered": true},
    "animation": {"engine": "canonicalize_fronted_values/render_ass_safe", "rendered": true},
    "auto_zoom": {"engine": "camera path + compositor", "rendered": true},
    "face_tracking": {"engine": "detect_face_subjects/build_camera_path", "rendered": true},
    "clip_count": {"engine": "candidate selection + render loop", "rendered": true},
    "language": {"engine": "transcribe_local", "rendered": true},
    "normalize_audio": {"engine": "FFmpeg loudnorm", "rendered": true},
    "emoji_enabled": {"engine": "editorial_metadata + ASS renderer", "rendered": true}
  },
  "hard_rule": "No visible control may be accepted by UI while being ignored by the canonical renderer."
}

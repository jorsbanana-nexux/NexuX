# NexuX AI brain router
# Copy to .env locally. NEVER commit real API keys.
# Any provider exposing an OpenAI-compatible chat endpoint can be used.

# Which configured brain is preferred: primary | secondary | vision
NEXUX_AI_BRAIN=primary

# Primary AI brain
NEXUX_AI_PRIMARY_ENDPOINT=
NEXUX_AI_PRIMARY_API_KEY=
NEXUX_AI_PRIMARY_MODEL=

# Secondary/fallback AI brain
NEXUX_AI_SECONDARY_ENDPOINT=
NEXUX_AI_SECONDARY_API_KEY=
NEXUX_AI_SECONDARY_MODEL=

# Vision-specialized AI brain
NEXUX_AI_VISION_ENDPOINT=
NEXUX_AI_VISION_API_KEY=
NEXUX_AI_VISION_MODEL=

# ─────────────────────────────────────────────
# NexuX V7.0 Environment Configuration
# ─────────────────────────────────────────────

# ── Server ──
HOST=127.0.0.1
PORT=8000

# ── CORS Origins ──
# Comma-separated list of allowed frontend origins
NEXUX_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ── API Authentication ──
# Leave empty for local dev (no auth). Set a random string for production.
# Generate one: python -c "import secrets; print(secrets.token_urlsafe(32))"
NEXUX_API_KEY=

# ── SQLite Persistent Storage ──
NEXUX_DB_PATH=nexux_jobs.db
NEXUX_JOB_TTL_HOURS=72

# ── Local Transcription ──
WHISPER_MODEL=small

# ── Optional AI Editorial Provider (disabled by default) ──
NEXUX_AI_ENABLED=0
NEXUX_AI_ENDPOINT=
NEXUX_AI_API_KEY=
NEXUX_AI_MODEL=

# NexuX V9.5 canonical runtime
DEBUG=false
HOST=127.0.0.1
PORT=8000

# Browser origins allowed to call the canonical API.
# Comma-separated; keep production origins explicit.
NEXUX_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Local transcription defaults
WHISPER_MODEL=small

# Optional AI editorial provider. Leave disabled for fully local operation.
NEXUX_AI_ENABLED=0
NEXUX_AI_ENDPOINT=
NEXUX_AI_API_KEY=
NEXUX_AI_MODEL=

# ── Mode 2: LLM Narrative Generation (Optional) ──
# Mode 2 (AI Creative) uses LLM to write viral narration scripts.
# Without any key, Mode 2 falls back to template-based narrative.
# Set ONE provider:

# Option A: OpenAI
#OPENAI_API_KEY=sk-your-key-here
#OPENAI_MODEL=gpt-4o

# Option B: Anthropic
#ANTHROPIC_API_KEY=sk-ant-your-key-here
#ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# Option C: Google Gemini (free tier available)
#GEMINI_API_KEY=your-key-here
#GEMINI_MODEL=gemini-1.5-flash

# ── YouTube / yt-dlp resilience (V9.6.2) ──
# Anti-403: export cookies from a logged-in browser session.
# Pick ONE. Cookies are secrets — keep the file out of version control.
#NEXUX_COOKIES_FILE=/path/to/cookies.txt          # Netscape format (export via "Get cookies.txt" extension)
#NEXUX_COOKIES_BROWSER=chrome                     # or: firefox, chrome:Default, chromium

# Anti-403: emulate alternate YouTube clients when the default web client is blocked.
#NEXUX_PLAYER_CLIENTS=android,ios,web_embedded

# Route ALL yt-dlp traffic (metadata + video streams) through a proxy.
# The durable fix when the host network cannot reach googlevideo.com at all.
#NEXUX_PROXY=socks5://127.0.0.1:1080

# yt-dlp self-updater (keeps pace with YouTube's weekly extractor changes).
# On by default; runs in background at startup + reactively on HTTP 403.
#NEXUX_YTDLP_AUTO_UPDATE=1
#NEXUX_YTDLP_UPDATE_DELAY=120

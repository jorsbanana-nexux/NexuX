# ─────────────────────────────────────────────
# NexuX V9.5 Environment Configuration
# ─────────────────────────────────────────────

# ── Server ──
HOST=127.0.0.1
PORT=8000

# ── CORS Origins ──
# Comma-separated list of allowed frontend origins
NEXUX_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ── API Authentication ──
# Leave empty for local dev (no auth). Set a random string for production.
# Generate one: python -c "import secrets; print(secrets.token_urlsafe(32))"
NEXUX_API_KEY=

# ── SQLite Persistent Storage ──
NEXUX_DB_PATH=nexux_jobs.db
NEXUX_JOB_TTL_HOURS=72

# ── Local Transcription ──
# Model: tiny / base / small / medium / large
WHISPER_MODEL=small

# ── Optional: AI Editorial Provider (disabled by default) ──
NEXUX_AI_ENABLED=0
NEXUX_AI_ENDPOINT=
NEXUX_AI_API_KEY=
NEXUX_AI_MODEL=

# ── Mode 2: LLM Narrative Generation (Optional) ──
# Mode 2 uses LLM to write viral narration scripts.
# Without any key, Mode 2 falls back to template-based narrative.
# Set ONE provider:

# Option A: OpenAI
#OPENAI_API_KEY=sk-your-key-here
#OPENAI_MODEL=gpt-4o

# Option B: Anthropic
#ANTHROPIC_API_KEY=sk-ant-your-key-here
#ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# Option C: Google Gemini (free tier available)
#GEMINI_API_KEY=your-key-here
#GEMINI_MODEL=gemini-1.5-flash

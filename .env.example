# NexuX V9.5 canonical runtime
DEBUG=false
HOST=127.0.0.1
PORT=8000

# Browser origins allowed to call the canonical API.
# Comma-separated; keep production origins explicit.
NEXUX_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Local transcription defaults
WHISPER_MODEL=small

# Optional AI editorial provider. Leave disabled for fully local operation.
NEXUX_AI_ENABLED=0
NEXUX_AI_ENDPOINT=
NEXUX_AI_API_KEY=
NEXUX_AI_MODEL=

# ── Mode 2: LLM Narrative Generation (Optional) ──
# Mode 2 (AI Creative) uses LLM to write viral narration scripts.
# Without any key, Mode 2 falls back to template-based narrative.
# Set ONE provider:

# Option A: OpenAI
#OPENAI_API_KEY=sk-your-key-here
#OPENAI_MODEL=gpt-4o

# Option B: Anthropic
#ANTHROPIC_API_KEY=sk-ant-your-key-here
#ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# Option C: Google Gemini (free tier available)
#GEMINI_API_KEY=your-key-here
#GEMINI_MODEL=gemini-1.5-flash
